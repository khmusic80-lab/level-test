rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 붙여넣고 "게시"하세요.
// STAFF_EMAILS에 로그인을 허용할 선생님 계정 이메일을 적으세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'khmusic80@hanmail.net'
        ];
    }

    function isValidReport() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'age', 'major', 'analysis_date', 'target_school', 'scores',
          'improvement', 'final_comment', 'average_score', 'created_at', 'updated_at'
        ])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.major is string
        && d.scores is map
        && d.average_score is number && d.average_score >= 0 && d.average_score <= 100;
    }

    match /entrance_reports/{reportId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && isValidReport();
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
